  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": [
          "confirmPassword",
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CheckCreateRequest": {
        "type": "object",
        "properties": {
          "idCheque": {
            "type": "integer",
            "format": "int32"
          },
          "numeroCheque": {
            "type": "integer",
            "format": "int32"
          },
          "nombreBanco": {
            "type": "string",
            "nullable": true
          },
          "idReservacion": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "Cheque": {
        "type": "object",
        "properties": {
          "idCheque": {
            "type": "integer",
            "format": "int32"
          },
          "numeroCheque": {
            "type": "integer",
            "format": "int32"
          },
          "nombreBanco": {
            "type": "string",
            "nullable": true
          },
          "idReservacion": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CustomerEditRequest": {
        "required": [
          "cedula",
          "direccion",
          "email",
          "nombreCompleto",
          "telefono"
        ],
        "type": "object",
        "properties": {
          "cedula": {
            "maxLength": 25,
            "minLength": 0,
            "type": "string"
          },
          "nombreCompleto": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "telefono": {
            "maxLength": 15,
            "minLength": 0,
            "type": "string"
          },
          "direccion": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "format": "email"
          }
        },
        "additionalProperties": false
      },
      "CustomerRegisterRequest": {
        "required": [
          "cedula",
          "confirmPassword",
          "direccion",
          "email",
          "nombreCompleto",
          "password",
          "telefono",
          "tipoCedula"
        ],
        "type": "object",
        "properties": {
          "cedula": {
            "minLength": 1,
            "pattern": "^[0-9]{9}$",
            "type": "string"
          },
          "tipoCedula": {
            "maxLength": 20,
            "minLength": 0,
            "type": "string"
          },
          "nombreCompleto": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "telefono": {
            "maxLength": 15,
            "minLength": 0,
            "type": "string"
          },
          "direccion": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string"
          },
          "email": {
            "maxLength": 150,
            "minLength": 0,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 128,
            "minLength": 12,
            "type": "string"
          },
          "confirmPassword": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "EmployeeCreateRequest": {
        "required": [
          "confirmPassword",
          "email",
          "nombreCompleto",
          "password"
        ],
        "type": "object",
