@model AppWebBeachSA.ViewModels.CustomerRegisterViewModel

@{
    ViewData["Title"] = "Create customer account";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool isStaff = User.IsInRole("Admin") || User.IsInRole("Employee");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <p class="text-uppercase text-secondary small mb-2">Customer registration</p>
                    <h1 class="mb-3">@(isStaff ? "Create customer account" : "Create your account")</h1>
                    <p class="text-secondary mb-4">
                        Review the identification details, add contact information, and choose a password.
                    </p>

                    <form asp-controller="Clientes" asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                        <h2 class="h5 mb-3">Identification</h2>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cedula" class="form-label">National ID number</label>
                                <input asp-for="Cedula" class="form-control bg-light" readonly />
                                <span asp-validation-for="Cedula" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="TipoCedula" class="form-label">Identification type</label>
                                <input asp-for="TipoCedula" class="form-control bg-light" readonly />
                                <span asp-validation-for="TipoCedula" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label">Full name</label>
                            <input asp-for="NombreCompleto" class="form-control bg-light" readonly />
                            <span asp-validation-for="NombreCompleto" class="text-danger"></span>
                        </div>

                        <p class="small mb-4">
                            Incorrect identification number?
                            <a asp-action="ObtenerInformacionPersona">Search again</a>
                        </p>

                        <hr class="my-4" />

                        <h2 class="h5 mb-3">Contact information</h2>

                        <div class="row">
                            <div class="col-md-5 mb-3">
                                <label asp-for="Telefono" class="form-label">Phone number</label>
                                <input asp-for="Telefono" type="tel" class="form-control" maxlength="15" autocomplete="tel" />
                                <span asp-validation-for="Telefono" class="text-danger"></span>
                            </div>

                            <div class="col-md-7 mb-3">
                                <label asp-for="Email" class="form-label">Email address</label>
                                <input asp-for="Email" type="email" class="form-control" maxlength="150" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Direccion" class="form-label">Address</label>
                            <textarea asp-for="Direccion" class="form-control" rows="3" maxlength="150" autocomplete="street-address"></textarea>
                            <span asp-validation-for="Direccion" class="text-danger"></span>
                        </div>

                        <hr class="my-4" />

                        <h2 class="h5 mb-3">Account password</h2>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" minlength="12" maxlength="128" autocomplete="new-password" aria-describedby="passwordHelp" />
                            <div id="passwordHelp" class="form-text">
                                Use between 12 and 128 characters. A long, unique passphrase is a good choice.
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" minlength="12" maxlength="128" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between gap-3 mt-4">
                            <a asp-action="ObtenerInformacionPersona" class="btn btn-outline-secondary">Back</a>
                            <button type="submit" class="btn btn-dark">Create account</button>
                        </div>

                        @if (!isStaff)
                        {
                            <p class="text-center text-secondary small mt-4 mb-0">
                                Already have an account?
                                <a asp-action="Login">Sign in</a>
                            </p>
                        }
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}