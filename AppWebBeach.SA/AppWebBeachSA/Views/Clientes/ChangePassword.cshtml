@model AppWebBeachSA.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <link rel="stylesheet"
          href="~/css/forms.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/AppWebBeachSA.styles.css"
          asp-append-version="true" />
</head>

<div class="d-flex justify-content-center">
    <div>
        <h1 class="text-center text-uppercase">
            Change Password
        </h1>

        <h4 class="text-center">
            Update your password
        </h4>
    </div>
</div>

<hr />

<div class="d-flex justify-content-center">
    <div class="password-card">
        <form asp-action="ChangePassword" method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger">
            </div>

            <div class="form-group mb-3">
                <label asp-for="CurrentPassword"
                       class="control-label">
                    Current password
                </label>

                <input asp-for="CurrentPassword"
                       class="form-control input" />

                <span asp-validation-for="CurrentPassword"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="NewPassword"
                       class="control-label">
                    New password
                </label>

                <input asp-for="NewPassword"
                       class="form-control input" />

                <span asp-validation-for="NewPassword"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ConfirmPassword"
                       class="control-label">
                    Confirm new password
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control input" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>
            </div>

            <div class="form-group pt-3 d-flex justify-content-between">
                <a asp-action="Index"
                   asp-controller="Home"
                   class="btn boton">
                    Back
                </a>

                <input type="submit" value="Save" class="btn boton password-save" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}