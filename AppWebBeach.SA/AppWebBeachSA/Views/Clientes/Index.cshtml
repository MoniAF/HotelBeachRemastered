@model IEnumerable<AppWebBeachSA.Models.Cliente>

@{
    ViewData["Title"] = "Customers";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var customers = Model?.ToList() ?? new List<AppWebBeachSA.Models.Cliente>();
    string loadError = ViewData["LoadError"] as string;
}

<div class="container py-5">
    <div class="card border-0 shadow-sm rounded-4 bg-white">
        <div class="card-body p-4 p-md-5">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
                <div>
                    <p class="text-uppercase text-secondary small mb-2">Hotel management</p>
                    <h1 class="mb-2">Customers</h1>
                    <p class="text-secondary mb-0">Manage customer profiles and contact information.</p>
                </div>

                <a asp-controller="Clientes" asp-action="ObtenerInformacionPersona" class="btn btn-dark">
                    <i class="fa-solid fa-user-plus me-2" aria-hidden="true"></i>New customer
                </a>
            </div>

            @if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="alert alert-danger mb-0" role="alert">
                    <p class="mb-3">@loadError</p>
                    <a asp-action="Index" class="btn btn-outline-danger btn-sm">Try again</a>
                </div>
            }
            else if (customers.Count == 0)
            {
                <div class="text-center border rounded-3 p-5">
                    <i class="fa-solid fa-users fs-2 text-secondary mb-3" aria-hidden="true"></i>
                    <h2 class="h4">No customers yet</h2>
                    <p class="text-secondary mb-4">Registered customers will appear here.</p>
                    <a asp-action="ObtenerInformacionPersona" class="btn btn-outline-dark">Add a customer</a>
                </div>
            }
            else
            {
                <p class="text-secondary small mb-3">
                    @customers.Count @(customers.Count == 1 ? "customer" : "customers")
                </p>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <caption class="visually-hidden">Registered customers and profile actions</caption>

                        <thead class="table-light">
                            <tr>
                                <th scope="col">Customer</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Email</th>
                                <th scope="col">Address</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var customer in customers)
                            {
                                <tr>
                                    <th scope="row">
                                        <span class="d-block fw-semibold">@customer.NombreCompleto</span>
                                        <span class="d-block text-secondary small fw-normal">ID: @customer.Cedula</span>
                                    </th>

                                    <td class="text-nowrap">
                                        @(string.IsNullOrWhiteSpace(customer.Telefono) ? "—" : customer.Telefono)
                                    </td>

                                    <td class="text-break">
                                        @(string.IsNullOrWhiteSpace(customer.Email) ? "—" : customer.Email)
                                    </td>

                                    <td class="text-break">
                                        @(string.IsNullOrWhiteSpace(customer.Direccion) ? "—" : customer.Direccion)
                                    </td>

                                    <td>
                                        @if (customer.Estado == 'A')
                                        {
                                            <span class="badge rounded-pill bg-success">Active</span>
                                        }
                                        else if (customer.Estado == 'I')
                                        {
                                            <span class="badge rounded-pill bg-secondary">Inactive</span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-dark">Unknown</span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-end gap-2">
                                            <a asp-action="Details" asp-route-id="@customer.Cedula" class="btn btn-sm btn-outline-secondary" aria-label="View details for @customer.NombreCompleto">Details</a>
                                            <a asp-action="Edit" asp-route-id="@customer.Cedula" class="btn btn-sm btn-outline-dark" aria-label="Edit @customer.NombreCompleto">Edit</a>
                                            <a asp-action="Delete" asp-route-id="@customer.Cedula" class="btn btn-sm btn-outline-danger" aria-label="Review deletion of @customer.NombreCompleto">Delete</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>