@model AppWebBeachSA.ViewModels.ResetCustomerPasswordViewModel

@{
    ViewData["Title"] = "Reset customer password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
}

<section class="py-4 py-md-5" aria-labelledby="resetPasswordTitle">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">
                    <p class="small text-uppercase text-secondary fw-semibold mb-2">Hotel reception</p>
                    <h1 id="resetPasswordTitle" class="h3 mb-3">Reset customer password</h1>

                    @if (TempData["PasswordResetSuccess"] is string successMessage)
                    {
                        <div class="alert alert-success" role="status">
                            @successMessage
                        </div>

                        <a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.Cedula" class="btn boton">
                            Back to customer
                        </a>
                    }
                    else
                    {
                        <p class="text-secondary">
                            Verify the customer's identification document in person before continuing.
                            Let the customer enter a new password privately.
                        </p>

                        <form asp-controller="Clientes" asp-action="ResetPassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                            <div class="mb-3">
                                <label asp-for="Cedula" class="form-label">Customer identification number</label>
                                <input asp-for="Cedula" class="form-control" readonly />
                                <span asp-validation-for="Cedula" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="NewPassword" class="form-label">New password</label>
                                <input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                                <div id="passwordHelp" class="form-text">Use between 12 and 128 characters.</div>
                                <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="ConfirmPassword" class="form-label">Confirm new password</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>

                            <div class="form-check mb-2">
                                <input asp-for="IdentityVerified" class="form-check-input" required />
                                <label asp-for="IdentityVerified" class="form-check-label">
                                    I verified the customer's identity in person and confirmed that the identification number matches this account.
                                </label>
                            </div>

                            <span asp-validation-for="IdentityVerified" class="text-danger small d-block mb-4"></span>

                            <div class="d-flex justify-content-between gap-3">
                                <a asp-controller="Clientes" asp-action="Details" asp-route-id="@Model.Cedula" class="btn boton">
                                    Back
                                </a>

                                <button type="submit" class="btn btn-dark">
                                    Reset password
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}