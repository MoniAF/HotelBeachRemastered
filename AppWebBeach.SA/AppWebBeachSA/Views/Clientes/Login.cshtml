@model AppWebBeachSA.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Sign in";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<section class="py-4 py-md-5" aria-labelledby="loginTitle">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <p class="small text-uppercase text-secondary fw-semibold mb-2">Hotel Beach</p>
                        <h1 id="loginTitle" class="h2 mb-2">Welcome back</h1>
                        <p class="text-secondary mb-0">Sign in to manage your reservations.</p>
                    </div>

                    @if (TempData["Mensaje"] != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show" role="alert">
                            @TempData["Mensaje"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["MensajeSesion"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["MensajeSesion"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    <form asp-controller="Clientes" asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-medium">Email</label>
                            <input asp-for="Email" type="email" class="form-control form-control-lg rounded-3" autocomplete="username" placeholder="you@example.com" aria-describedby="emailError" />
                            <span asp-validation-for="Email" id="emailError" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-medium">Password</label>
                            <input asp-for="Password" type="password" class="form-control form-control-lg rounded-3" autocomplete="current-password" aria-describedby="passwordError" />
                            <span asp-validation-for="Password" id="passwordError" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg rounded-pill w-100">Sign in</button>
                    </form>

                    <div class="bg-light rounded-3 p-3 mt-4">
                        <h2 class="h6 mb-2">Forgot your password?</h2>
                        <p class="small text-secondary mb-2">
                            Visit the hotel reception with your identification document to reset your password.
                        </p>
                        <p class="small text-secondary mb-0">
                            If you need to make a reservation before your visit, call the hotel for assistance.
                        </p>
                    </div>

                    <p class="text-center text-secondary mt-4 mb-0">
                        New to Hotel Beach?
                        <a asp-controller="Clientes" asp-action="ObtenerInformacionPersona" class="fw-semibold text-decoration-underline">Create an account</a>
                    </p>

                    <hr class="my-4" />

                    <div class="text-center">
                        <a asp-controller="Empleados" asp-action="Login" class="small text-decoration-underline">Staff sign in</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}