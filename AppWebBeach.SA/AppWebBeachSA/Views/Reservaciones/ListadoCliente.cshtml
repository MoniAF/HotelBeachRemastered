@model AppWebBeachSA.Models.ReservacionPaqueteLista

@{
    ViewData["Title"] = "Reservaciones";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal? exchangeRate = ViewData["ExchangeRate"] == null ? null : Convert.ToDecimal(ViewData["ExchangeRate"]);
}
@if (TempData["ReceiptError"] is string receiptError)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @receiptError
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
<head class="fondo">
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AppWebBeachSA.styles.css" asp-append-version="true" />
</head>
<body class="bg-reserva">
    <section class="bg-color">
        <h1>Reservaciones</h1>
        <p>
            <a class="btn boton" asp-action="ConfirmarCliente">Nueva Reservación</a>
        </p>

        @if (ViewData["LoadError"] != null)
        {
            <div class="alert alert-danger" role="alert">
                @ViewData["LoadError"]
            </div>
        }
        else if (!Model.ListaReservaciones.Any())
        {
            <div class="alert alert-info" role="status">
                No reservations found.
            </div>
        }

        <table class="table">
            <thead>
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.ListaReservaciones.First().CedulaCliente)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ListaReservaciones.First().TipoPago)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ListaReservaciones.First().FechaReserva)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ListaReservaciones.First().Duracion)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ListaReservaciones.First().MontoTotal)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.ListaReservaciones.First().MontoMensualidad)
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListaReservaciones)
                {

                    var modalID = "R" + item.Id;

                    <tr>
                        <td class="align-text">
                            @Html.DisplayFor(modelItem => item.CedulaCliente)
                        </td>
                        <td class="align-text">
                            @Html.DisplayFor(modelItem => item.TipoPago)
                        </td>
                        <td class="align-text">
                            @Html.DisplayFor(modelItem => item.FechaReserva)
                        </td>
                        <td class="align-text">
                            @Html.DisplayFor(modelItem => item.Duracion)
                        </td>
                        <td class="align-text">
                            @Html.DisplayFor(modelItem => item.MontoTotal)
                        </td>
                        <td class="align-text">
                            @Html.DisplayFor(modelItem => item.MontoMensualidad)
                        </td>
                        <td class="btn-group">
                            @Html.ActionLink("Edit", "Edit", new { id = item.Id }, new { @class = "btn boton" })
                            <button class="btn boton" type="button" data-bs-toggle="modal" data-bs-target="#@modalID">Details</button>
                            @Html.ActionLink("Delete", "Delete", new { id = item.Id }, new { @class = "btn boton" })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>
</body>

@foreach (var reserva in Model.ListaReservaciones)
{
    var modalID = "R" + reserva.Id;
    var modalTitleID = modalID + "-title";
    string nombrePack = "Package unavailable";

    foreach (var item in Model.ListaPaquetes)
    {
        if (item.ID == reserva.IdPaquete)
        {
            nombrePack = item.NombrePaquete;
            break;
        }
    }

    decimal? totalColones = null;

    if (exchangeRate.HasValue && exchangeRate.Value > 0)
    {
        totalColones = Math.Round(reserva.MontoTotal * exchangeRate.Value, 2);
    }

    <div class="modal fade" id="@modalID" tabindex="-1" aria-labelledby="@modalTitleID" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="@modalTitleID">Reservation #@reserva.Id</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="card">
                        <div class="card-header text-center">
                            Customer ID: @reserva.CedulaCliente
                        </div>

                        <ul class="list-group list-group-flush">
                            <li class="list-group-item">
                                Package: @nombrePack
                            </li>

                            <li class="list-group-item">
                                Subtotal (USD): $@reserva.Subtotal.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                            </li>

                            <li class="list-group-item">
                                Tax (USD): $@reserva.Impuesto.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                            </li>

                            @if (reserva.Descuento > 0)
                            {
                                <li class="list-group-item">
                                    Discount (USD): $@reserva.Descuento.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                                </li>
                            }

                            <li class="list-group-item">
                                Total (USD): $@reserva.MontoTotal.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                            </li>

                            <li class="list-group-item">
                                Estimated total (CRC):
                                @if (totalColones.HasValue)
                                {
                                    <span>₡ @totalColones.Value.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</span>
                                }
                                else
                                {
                                    <span class="text-muted">Conversion unavailable</span>
                                }
                            </li>

                            <li class="list-group-item">
                                Down payment (USD): $@reserva.Adelanto.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                            </li>

                            <li class="list-group-item">
                                Monthly payment (USD): $@reserva.MontoMensualidad.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="modal-footer">
                    @if (reserva.TipoPago == "Cheque" && reserva.Estado == 'A')
                    {
                        <a asp-controller="Cheques" asp-action="Edit" asp-route-id="@reserva.Id" class="btn btn-outline-dark">Check details</a>
                    }

                    <a asp-controller="Reservaciones" asp-action="DownloadReceipt" asp-route-id="@reserva.Id" class="btn btn-outline-dark"> <i class="fa-solid fa-file-pdf me-1" aria-hidden="true"></i> Download receipt </a>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}