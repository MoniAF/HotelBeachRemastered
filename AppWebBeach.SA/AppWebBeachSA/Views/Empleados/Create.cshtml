@model AppWebBeachSA.ViewModels.EmployeeCreateViewModel

@{
    ViewData["Title"] = "Add employee";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
}

<section class="py-4" aria-labelledby="createEmployeeTitle">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">
            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">
                    <p class="small text-uppercase text-secondary fw-semibold mb-2">Hotel management</p>
                    <h1 id="createEmployeeTitle" class="h2 mb-2">Add employee</h1>
                    <p class="text-secondary mb-4">Create a staff account with the Employee role.</p>

                    <form asp-controller="Empleados" asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label">Full name</label>
                            <input asp-for="NombreCompleto" class="form-control" maxlength="150" autocomplete="name" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" maxlength="50" autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">Password</label>
                            <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" aria-describedby="passwordHelp" />
                            <div id="passwordHelp" class="form-text">Use between 12 and 128 characters.</div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label">Confirm password</label>
                            <input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Estado" class="form-label">Status</label>
                            <select asp-for="Estado" class="form-select">
                                <option value="A">Active</option>
                                <option value="I">Inactive</option>
                            </select>
                            <span asp-validation-for="Estado" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between gap-3">
                            <a asp-controller="Empleados" asp-action="Index" class="btn boton">Back</a>
                            <button type="submit" class="btn btn-dark">Create employee</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}