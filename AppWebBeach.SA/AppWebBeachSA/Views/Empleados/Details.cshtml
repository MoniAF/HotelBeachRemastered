@model AppWebBeachSA.Models.Empleado

@{
    ViewData["Title"] = "Employee details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
}

<section class="py-4" aria-labelledby="employeeDetailsTitle">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">
                    <p class="small text-uppercase text-secondary fw-semibold mb-2">Hotel management</p>
                    <h1 id="employeeDetailsTitle" class="h2 mb-4">Employee details</h1>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Employee ID</dt>
                        <dd class="col-sm-8">@Model.ID</dd>

                        <dt class="col-sm-4">Full name</dt>
                        <dd class="col-sm-8">@Model.NombreCompleto</dd>

                        <dt class="col-sm-4">Email</dt>
                        <dd class="col-sm-8 text-break">@Model.Email</dd>

                        <dt class="col-sm-4">Role</dt>
                        <dd class="col-sm-8">@(Model.TipoUsuario == 1 ? "Administrator" : Model.TipoUsuario == 2 ? "Employee" : "Unknown")</dd>

                        <dt class="col-sm-4">Registration date</dt>
                        <dd class="col-sm-8">@Model.FechaRegistro.ToString("yyyy-MM-dd HH:mm")</dd>

                        <dt class="col-sm-4">Status</dt>
                        <dd class="col-sm-8">@(Model.Estado == 'A' ? "Active" : Model.Estado == 'I' ? "Inactive" : "Unknown")</dd>
                    </dl>

                    <div class="d-flex justify-content-between gap-3">
                        <a asp-controller="Empleados" asp-action="Index" class="btn boton">Back</a>
                        <a asp-controller="Empleados" asp-action="Edit" asp-route-id="@Model.ID" class="btn btn-dark">Edit employee</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>