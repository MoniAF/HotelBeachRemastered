@model IEnumerable<AppWebBeachSA.Models.Empleado>

@{
    ViewData["Title"] = "Employees";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/forms.css" asp-append-version="true" />
}

<section class="py-4" aria-labelledby="employeesTitle">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="small text-uppercase text-secondary fw-semibold mb-2">Hotel management</p>
            <h1 id="employeesTitle" class="mb-1">Employees</h1>
            <p class="text-secondary mb-0">Manage hotel staff accounts.</p>
        </div>

        <a asp-controller="Empleados" asp-action="Create" class="btn boton">
            Add employee
        </a>
    </div>

    @if (TempData["Mensaje"] is string message)
    {
        <div class="alert alert-warning" role="alert">@message</div>
    }

    @if (TempData["EmployeeSuccess"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    @if (ViewData["LoadError"] is string loadError)
    {
        <div class="alert alert-danger" role="alert">@loadError</div>
    }
    else if (Model == null || !Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 text-center">
                <h2 class="h5">No employees to display</h2>
                <p class="text-secondary mb-0">Add an employee to get started.</p>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <caption class="visually-hidden">Hotel staff accounts and available actions.</caption>
                    <thead>
                        <tr>
                            <th scope="col">ID</th>
                            <th scope="col">Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Role</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr>
                                <th scope="row">@employee.ID</th>
                                <td>@employee.NombreCompleto</td>
                                <td>@employee.Email</td>
                                <td>@(employee.TipoUsuario == 1 ? "Administrator" : employee.TipoUsuario == 2 ? "Employee" : "Unknown")</td>
                                <td>
                                    @if (employee.Estado == 'A')
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else if (employee.Estado == 'I')
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Unknown</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-2">
                                        <a asp-action="Edit" asp-route-id="@employee.ID" class="btn btn-sm btn-outline-dark" aria-label="Edit @employee.NombreCompleto">Edit</a>
                                        <a asp-action="Details" asp-route-id="@employee.ID" class="btn btn-sm btn-outline-dark" aria-label="View details for @employee.NombreCompleto">Details</a>
                                        <a asp-action="Delete" asp-route-id="@employee.ID" class="btn btn-sm btn-outline-danger" aria-label="Review deletion of @employee.NombreCompleto">Delete</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>