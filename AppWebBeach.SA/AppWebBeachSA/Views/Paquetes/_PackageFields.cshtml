@model AppWebBeachSA.Models.Paquete

<div class="row g-4">
    <div class="col-12">
        <label asp-for="NombrePaquete" class="form-label">Package name</label>
        <input asp-for="NombrePaquete" class="form-control" maxlength="150" placeholder="Enter the package name" />
        <span asp-validation-for="NombrePaquete" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Precio" class="form-label">Price</label>
        <input asp-for="Precio" type="number" step="0.01" min="0.01" max="9999999999.99" class="form-control" />
        <span asp-validation-for="Precio" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="PorcentajePrima" class="form-label">Down payment (%)</label>
        <input asp-for="PorcentajePrima" type="number" step="0.01" min="0" max="100" class="form-control" />
        <span asp-validation-for="PorcentajePrima" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="LimiteMeses" class="form-label">Month limit</label>
        <input asp-for="LimiteMeses" type="number" step="1" min="0" class="form-control" />
        <span asp-validation-for="LimiteMeses" class="text-danger small"></span>
    </div>

    <div class="col-12 col-md-6">
        <label asp-for="Estado" class="form-label">Status</label>
        <select asp-for="Estado" class="form-select">
            <option value="A">Active</option>
            <option value="I">Inactive</option>
        </select>
        <span asp-validation-for="Estado" class="text-danger"></span>
    </div>
</div>