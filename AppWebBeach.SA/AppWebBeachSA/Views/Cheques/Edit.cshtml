@model AppWebBeachSA.Models.Cheque

@{
    ViewData["Title"] = "Edit check";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string backAction = User.IsInRole("Customer") ? "ListadoCliente" : "Listado";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-4 p-md-5">
                    <p class="text-uppercase text-secondary small mb-2">Reservation #@Model.IdReservacion</p>
                    <h1 class="mb-3">Edit check</h1>
                    <p class="text-secondary mb-4">Update the check number and bank information.</p>

                    <form asp-controller="Cheques" asp-action="Edit" method="post">
                        <input type="hidden" asp-for="IdCheque" />
                        <input type="hidden" asp-for="IdReservacion" />

                        <div asp-validation-summary="All" class="text-danger mb-3" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NumeroCheque" class="form-label">Check number</label>
                            <input asp-for="NumeroCheque" type="number" min="1" max="2147483647" step="1" class="form-control" required />
                            <span asp-validation-for="NumeroCheque" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreBanco" class="form-label">Bank name</label>
                            <input asp-for="NombreBanco" class="form-control" required />
                            <span asp-validation-for="NombreBanco" class="text-danger"></span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between gap-3 mt-4">
                            <a asp-controller="Reservaciones" asp-action="@backAction" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-dark">Save changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
